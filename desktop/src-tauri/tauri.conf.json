{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenSolar Pro",
  "version": "2.0.0",
  "identifier": "com.gensolar.pro",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GenSolar Pro",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https: data: blob:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"]
  }
}
